# 深度求索 API
DEEPSEEK_API_KEY="your-deepseek-api-key"

# 阿里云千问 API
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
#向量模型
DASHSCOPE_WORKSPACE_BASE_URL="https://ws-mfdgr10bwi4ng3bj.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# Tavily 搜索 API
TAVILY_API_KEY="your-tavily-api-key"

# MySQL 数据库
DATABASE_URL="mysql+aiomysql://user:password@localhost:3306/dbname"

# JWT 密钥（生产环境务必改成随机长字符串）
SECRET_KEY=change-me-to-a-random-secret

# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 返回给前端的文件访问基础地址
# 本地开发保持默认即可；部署时与前端同源则设为空字符串：BACKEND_BASE_URL=""
BACKEND_BASE_URL="http://127.0.0.1:8000"

# 模型优先级列表（逗号分隔），额度用尽自动切下一个
LLM_MODEL_PRIORITY=qwen3.7-plus,qwen-vl-plus,qwen-vl-max
TITLE_MODEL_PRIORITY=qwen3.7-plus,qwen-turbo
EMBEDDING_MODEL=qwen3.7-text-embedding